<launch>
  <arg name="param_file" default="$(find-pkg-share ekf_localizer)/config/ekf_localizer_gnss.param.yaml"/>
  <arg name="ekf_mode" default="gnss"/>
  <arg name="ekf_node_name" default="ekf_localizer_gnss"/>
  <arg name="gnss_input_topic" default="/gnss_pose_localcartesian_faulty"
       description="Set to /gnss_pose_localcartesian_faulty for fault injection experiments"/>

  <group>
    <push-ros-namespace namespace="localization/gnss"/>

    <!-- GNSS PoseStamped -> PoseWithCovarianceStamped -->
    <node pkg="pose_to_pose_with_cov"
          exec="pose_to_pose_with_cov"
          name="pose_converter_gnss"
          output="screen">
      <!-- 입력: GNSS PoseStamped (use_faulty 시 faulty 토픽으로 자동 전환) -->
      <param name="input_topic" value="$(var gnss_input_topic)"/>


      <!-- 출력: EKF에 넣을 PoseWithCovarianceStamped -->
      <param name="output_topic" value="/gnss_pose_with_covariance"/>

      <!-- frame -->
      <param name="expected_frame_id" value="map"/>

      <!-- LiDAR와 동일한 공분산 -->
      <param name="sigma_xy_m" value="0.05"/>
      <param name="sigma_yaw_deg" value="1.0"/>
      <param name="use_zrp" value="false"/>
      <param name="sigma_z_m" value="0.05"/>
      <param name="sigma_rp_deg" value="1.0"/>
      <param name="big_unc" value="1000000.0"/>

    </node>

    <!-- GNSS EKF -->
    <node pkg="ekf_localizer"
          exec="ekf_localizer"
          name="$(var ekf_node_name)"
          output="screen">
      <!-- pose 입력을 변환된 토픽으로 변경 -->
      <remap from="in_pose_with_covariance" to="/gnss_pose_with_covariance"/>

      <!-- twist 입력 -->
      <remap from="in_twist_with_covariance" to="/gyro_twist_with_covariance_gnss"/>

      <remap from="initialpose" to="/initialpose"/>
      <remap from="trigger_node_srv" to="trigger_node"/>

      <param from="$(var param_file)"/>
      <param name="ekf_mode" value="$(var ekf_mode)"/>
      <param name="pose_frame_id" value="map"/>
    </node>
  </group>
</launch>